# Rakt-Connect Network Configuration & Deployment Secrets
# COPY THIS FILE TO .env AND POPULATE STRONG ENTROPY SECRETS (MINIMUM 32 CHARACTERS)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL

# ── Gateway Authentication & Administration ────────────────────────────────────
JWT_SECRET=replace_with_strong_jwt_secret_min_32_characters_entropy
ADMIN_SERVICE_KEY=replace_with_strong_admin_service_key_min_32_characters

# ── Blockchain & Gateway Behavior ──────────────────────────────────────────────
NODE_ENV=production
PORT=3001
REQUIRE_FABRIC=false

# ── Hyperledger Fabric Topology ────────────────────────────────────────────────
FABRIC_PEER_ENDPOINT=peer0.hospital.raktconnect.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.hospital.raktconnect.com
FABRIC_ORDERER_ENDPOINT=orderer1.raktconnect.com:7050
FABRIC_MSP_ID=HospitalMSP
FABRIC_TLS_CERT_PATH=/etc/rakt/crypto/peerOrganizations/hospital.raktconnect.com/tlsca/tlsca.hospital.raktconnect.com-cert.pem
FABRIC_WALLET_PATH=/etc/rakt/wallet/admin.id

# ── Microservices ──────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-microservice:8000
