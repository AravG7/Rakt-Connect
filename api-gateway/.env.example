# Rakt-Connect API Gateway Environment Configuration
# NEVER commit production secrets to version control.

PORT=3000
NODE_ENV=development

# Mandatory 256-bit+ cryptographic secrets
# In production, these MUST be set or the gateway will fail to start.
JWT_SECRET=replace_with_secure_random_64_char_hex_secret_in_production
ADMIN_SERVICE_KEY=replace_with_secure_admin_service_token_in_production

# Hyperledger Fabric Connection
FABRIC_CHANNEL=rakt-channel
FABRIC_CHAINCODE=blood-bank
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.hospital.rakt.org
FABRIC_MSP_ID=HospitalMSP

# Post-Quantum Vault (ML-KEM-768)
PQC_HKDF_SALT=RaktConnect_PQC_System_Salt_Verification_V1

# ABDM & OTP Sandbox / Provider Settings
ABDM_SANDBOX_BASE_URL=https://sandbox.abdm.gov.in
OTP_PROVIDER=SANDBOX_SIMULATION
